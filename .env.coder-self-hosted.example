# Self-hosted Coder deployment credentials (plain IP, no domain)
# Terraform: refs/coder-infra/terraform/self-hosted/
# Copy to .env.coder-self-hosted and fill in your values:
#   cp .env.coder-self-hosted.example .env.coder-self-hosted
CODER_URL=http://your-coder-ip-here
CODER_TOKEN=your-coder-session-token-here
